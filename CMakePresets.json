      "displayName": "x64 Debug",
      "inherits": "naru-debug",
      "toolchainFile": "${sourceDir}/build/${presetName}/conan/conan_toolchain.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "C:/Users/leejo/workspace/develope/tools/ninja/1.13.2/ninja.exe",
        "NARU_PRESET_ARCH": "x64"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "LLVM x64"
        }
      }
    },
