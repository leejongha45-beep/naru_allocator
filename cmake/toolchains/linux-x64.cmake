if (NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Use the WSL x64 toolchain for Linux presets.")
endif ()
if (NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
    message(FATAL_ERROR "The Linux toolchain requires an x64 host.")
endif ()
if (NOT DEFINED ENV{NARU_LINUX_TOOLS_ROOT})
    message(FATAL_ERROR "NARU_LINUX_TOOLS_ROOT must point to tools/linux-x64.")
endif ()

set(CMAKE_C_COMPILER "$ENV{NARU_LINUX_TOOLS_ROOT}/llvm/bin/clang")
set(CMAKE_CXX_COMPILER "$ENV{NARU_LINUX_TOOLS_ROOT}/llvm/bin/clang++")
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-linux-gnu)
set(CMAKE_AR "$ENV{NARU_LINUX_TOOLS_ROOT}/llvm/bin/llvm-ar")
set(CMAKE_RANLIB "$ENV{NARU_LINUX_TOOLS_ROOT}/llvm/bin/llvm-ranlib")
set(CMAKE_LINKER "$ENV{NARU_LINUX_TOOLS_ROOT}/llvm/bin/ld.lld")
set(CMAKE_LINKER_TYPE LLD)
